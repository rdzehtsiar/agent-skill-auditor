{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-auditor.local/schemas/report.schema.json",
  "title": "Agent Skill Auditor JSON report",
  "type": "object",
  "required": [
    "packages",
    "findings",
    "suppressed_findings",
    "summary"
  ],
  "properties": {
    "packages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skillFinding"
      }
    },
    "finding_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/findingGroup"
      }
    },
    "suppressed_findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "object"
    },
    "supply_chain": {
      "$ref": "#/$defs/supplyChainInventory"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibilityMatrix"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "supplyChainInventory": {
      "type": "object",
      "required": [
        "licenses",
        "trust_manifests",
        "external_urls",
        "remote_dependencies",
        "package_managers",
        "lockfiles",
        "executables",
        "binaries",
        "checksums",
        "permissions",
        "offline_readiness"
      ],
      "properties": {
        "licenses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/licenseEvidence"
          }
        },
        "trust_manifests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trustManifest"
          }
        },
        "external_urls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalUrl"
          }
        },
        "remote_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/remoteDependency"
          }
        },
        "package_managers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packageManagerEvidence"
          }
        },
        "lockfiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockfileEvidence"
          }
        },
        "executables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executableArtifact"
          }
        },
        "binaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binaryArtifact"
          }
        },
        "checksums": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checksumEvidence"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permissionEvidence"
          }
        },
        "offline_readiness": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/offlineReadiness"
          }
        }
      },
      "additionalProperties": false
    },
    "licenseEvidence": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "scope",
        "normalized",
        "raw",
        "confidence"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "scope": {
          "$ref": "#/$defs/licenseScope"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        }
      },
      "additionalProperties": false
    },
    "trustManifest": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "format",
        "normalized",
        "raw",
        "confidence",
        "valid",
        "diagnostics",
        "skill",
        "provenance",
        "permissions",
        "declared_dependencies"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "format": {
          "$ref": "#/$defs/trustManifestFormat"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        },
        "valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trustManifestDiagnostic"
          }
        },
        "skill": {
          "anyOf": [
            {
              "$ref": "#/$defs/trustManifestSkill"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/trustManifestProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/trustManifestPermissions"
            },
            {
              "type": "null"
            }
          ]
        },
        "declared_dependencies": {
          "$ref": "#/$defs/trustManifestDeclaredDependencies"
        }
      },
      "additionalProperties": false
    },
    "trustManifestDiagnostic": {
      "type": "object",
      "required": [
        "path",
        "line",
        "kind",
        "message",
        "field"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "kind": {
          "$ref": "#/$defs/trustManifestDiagnosticKind"
        },
        "message": {
          "type": "string"
        },
        "field": {
          "$ref": "#/$defs/optionalString"
        }
      },
      "additionalProperties": false
    },
    "trustManifestSkill": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/optionalString"
        },
        "version": {
          "$ref": "#/$defs/optionalString"
        }
      },
      "additionalProperties": false
    },
    "trustManifestProvenance": {
      "type": "object",
      "required": [
        "source",
        "commit",
        "signed"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/optionalString"
        },
        "commit": {
          "$ref": "#/$defs/optionalString"
        },
        "signed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "trustManifestPermissions": {
      "type": "object",
      "required": [
        "network",
        "filesystem_write",
        "secrets"
      ],
      "properties": {
        "network": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "filesystem_write": {
          "$ref": "#/$defs/optionalString"
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "trustManifestDeclaredDependencies": {
      "type": "object",
      "required": [
        "commands",
        "packages"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trustManifestPackageDependency"
          }
        }
      },
      "additionalProperties": false
    },
    "trustManifestPackageDependency": {
      "type": "object",
      "required": [
        "ecosystem",
        "name",
        "version"
      ],
      "properties": {
        "ecosystem": {
          "$ref": "#/$defs/optionalString"
        },
        "name": {
          "$ref": "#/$defs/optionalString"
        },
        "version": {
          "$ref": "#/$defs/optionalString"
        }
      },
      "additionalProperties": false
    },
    "externalUrl": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "kind",
        "normalized",
        "raw",
        "confidence",
        "pinned"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "kind": {
          "$ref": "#/$defs/externalUrlKind"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        },
        "pinned": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "remoteDependency": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "kind",
        "package_manager",
        "name",
        "version",
        "normalized",
        "raw",
        "confidence",
        "pinned"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "kind": {
          "$ref": "#/$defs/remoteDependencyKind"
        },
        "package_manager": {
          "anyOf": [
            {
              "$ref": "#/$defs/packageManagerKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "$ref": "#/$defs/optionalString"
        },
        "version": {
          "$ref": "#/$defs/optionalString"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        },
        "pinned": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "packageManagerEvidence": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "manager",
        "manifest_path",
        "normalized",
        "raw",
        "confidence"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "manager": {
          "$ref": "#/$defs/packageManagerKind"
        },
        "manifest_path": {
          "$ref": "#/$defs/optionalString"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        }
      },
      "additionalProperties": false
    },
    "lockfileEvidence": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "manager",
        "normalized",
        "raw",
        "confidence"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "manager": {
          "$ref": "#/$defs/packageManagerKind"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        }
      },
      "additionalProperties": false
    },
    "executableArtifact": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "kind",
        "language",
        "reason",
        "referenced",
        "normalized",
        "raw",
        "confidence"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "kind": {
          "$ref": "#/$defs/executableKind"
        },
        "language": {
          "$ref": "#/$defs/optionalString"
        },
        "reason": {
          "type": "string"
        },
        "referenced": {
          "type": "boolean"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        }
      },
      "additionalProperties": false
    },
    "binaryArtifact": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "kind",
        "size_bytes",
        "referenced",
        "normalized",
        "raw",
        "confidence"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "kind": {
          "$ref": "#/$defs/binaryArtifactKind"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "referenced": {
          "type": "boolean"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        }
      },
      "additionalProperties": false
    },
    "checksumEvidence": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "algorithm",
        "digest",
        "target_path",
        "normalized",
        "raw",
        "confidence"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "algorithm": {
          "$ref": "#/$defs/checksumAlgorithm"
        },
        "digest": {
          "type": "string"
        },
        "target_path": {
          "$ref": "#/$defs/optionalString"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        }
      },
      "additionalProperties": false
    },
    "permissionEvidence": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "kind",
        "evidence",
        "normalized",
        "raw",
        "confidence"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "kind": {
          "$ref": "#/$defs/permissionKind"
        },
        "evidence": {
          "$ref": "#/$defs/permissionEvidenceKind"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        }
      },
      "additionalProperties": false
    },
    "offlineReadiness": {
      "type": "object",
      "required": [
        "path",
        "status",
        "score",
        "reasons"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/offlineReadinessStatus"
        },
        "score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "optionalLine": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "optionalString": {
      "type": [
        "string",
        "null"
      ]
    },
    "supplyChainSourceKind": {
      "type": "string",
      "enum": [
        "frontmatter",
        "markdown-link",
        "inline-code",
        "code-block",
        "script",
        "package-manifest",
        "lockfile",
        "trust-manifest",
        "filesystem",
        "inferred"
      ]
    },
    "evidenceConfidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "licenseScope": {
      "type": "string",
      "enum": [
        "repository",
        "skill"
      ]
    },
    "trustManifestFormat": {
      "type": "string",
      "enum": [
        "agent-audit",
        "unknown"
      ]
    },
    "trustManifestDiagnosticKind": {
      "type": "string",
      "enum": [
        "parse-error",
        "schema-error",
        "unknown-field"
      ]
    },
    "externalUrlKind": {
      "type": "string",
      "enum": [
        "documentation",
        "remote-script",
        "downloaded-artifact",
        "package-registry",
        "github-raw",
        "github-release-asset",
        "http-endpoint",
        "localhost",
        "internal",
        "unknown"
      ]
    },
    "remoteDependencyKind": {
      "type": "string",
      "enum": [
        "package",
        "script",
        "artifact",
        "repository",
        "service",
        "unknown"
      ]
    },
    "packageManagerKind": {
      "type": "string",
      "enum": [
        "npm",
        "yarn",
        "pnpm",
        "pip",
        "poetry",
        "uv",
        "cargo",
        "go",
        "gem",
        "composer",
        "unknown"
      ]
    },
    "executableKind": {
      "type": "string",
      "enum": [
        "script",
        "binary",
        "command",
        "unknown"
      ]
    },
    "binaryArtifactKind": {
      "type": "string",
      "enum": [
        "executable",
        "archive",
        "wasm",
        "jar",
        "opaque-asset",
        "unknown"
      ]
    },
    "checksumAlgorithm": {
      "type": "string",
      "enum": [
        "sha256",
        "sha384",
        "sha512",
        "unknown"
      ]
    },
    "permissionKind": {
      "type": "string",
      "enum": [
        "network",
        "filesystem-read",
        "filesystem-write",
        "secrets",
        "subprocess",
        "package-install",
        "binary-execution",
        "git-operations",
        "privilege-escalation"
      ]
    },
    "permissionEvidenceKind": {
      "type": "string",
      "enum": [
        "declared",
        "observed"
      ]
    },
    "offlineReadinessStatus": {
      "type": "string",
      "enum": [
        "ready",
        "partial",
        "not-ready",
        "unknown"
      ]
    },
    "findingGroup": {
      "type": "object",
      "required": [
        "rule_id",
        "severity",
        "category",
        "title",
        "rationale",
        "remediation",
        "suppression",
        "evidence_key",
        "dimensions",
        "finding_count",
        "affected_package_count",
        "affected_packages",
        "evidence_samples"
      ],
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "confidence": {
          "$ref": "#/$defs/findingConfidence"
        },
        "category": {
          "$ref": "#/$defs/findingCategory"
        },
        "title": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        },
        "suppression": {
          "type": "string"
        },
        "evidence_key": {
          "type": "string"
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "affected_package_count": {
          "type": "integer",
          "minimum": 0
        },
        "affected_packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/findingEvidenceSample"
          }
        }
      },
      "additionalProperties": false
    },
    "skillFinding": {
      "type": "object",
      "required": [
        "rule_id",
        "severity",
        "category",
        "title",
        "message",
        "location",
        "rationale",
        "remediation",
        "suppression"
      ],
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "confidence": {
          "$ref": "#/$defs/findingConfidence"
        },
        "category": {
          "$ref": "#/$defs/findingCategory"
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/findingLocation"
        },
        "rationale": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        },
        "suppression": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "findingEvidenceSample": {
      "type": "object",
      "required": [
        "location",
        "message"
      ],
      "properties": {
        "location": {
          "$ref": "#/$defs/findingLocation"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "findingLocation": {
      "type": "object",
      "required": [
        "path",
        "line"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        }
      },
      "additionalProperties": false
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "findingConfidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "findingCategory": {
      "type": "string",
      "enum": [
        "spec",
