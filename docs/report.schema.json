{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-auditor.local/schemas/report.schema.json",
  "title": "Agent Skill Auditor JSON report",
  "type": "object",
  "required": [
    "audit",
    "packages",
    "findings",
    "suppressed_findings",
    "patterns",
    "summary"
  ],
  "properties": {
    "audit": {
      "$ref": "#/$defs/auditMetadata"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skillFinding"
      }
    },
    "finding_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/findingGroup"
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ecosystemPattern"
      }
    },
    "suppressed_findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "$ref": "#/$defs/scanSummary"
    },
    "supply_chain": {
      "$ref": "#/$defs/supplyChainInventory"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibilityMatrix"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "publicDataset": {
      "description": "Public-safe dataset emitted by --format public-json. This projection keeps audit metadata, repository metadata, package identifiers, findings, groups, metrics, patterns, and bounded evidence snippets while omitting full SKILL.md bodies, code block bodies, inline code bodies, and other large manifest content.",
      "type": "object",
      "required": [
        "audit",
        "repository",
        "packages",
        "findings",
        "finding_groups",
        "metrics",
        "patterns",
        "supply_chain"
      ],
      "properties": {
        "audit": {
          "$ref": "#/$defs/auditMetadata"
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/auditRepositoryMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "root",
              "manifest_path",
              "name",
              "description",
              "frontmatter_keys",
              "headings",
              "links",
              "declared_tools",
              "declared_permissions",
              "graph"
            ],
            "properties": {
              "root": {
                "type": "string"
              },
              "manifest_path": {
                "type": "string"
              },
              "name": {
                "$ref": "#/$defs/optionalString"
              },
              "description": {
                "$ref": "#/$defs/optionalString"
              },
              "frontmatter_keys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "headings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "declared_tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "declared_permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "graph": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "finding_groups": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metrics": {
          "type": "object"
        },
        "patterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ecosystemPattern"
          }
        },
        "supply_chain": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "auditMetadata": {
      "type": "object",
      "required": [
        "output_schema_version",
        "scanner",
        "ruleset",
        "host_profiles",
        "config",
        "scan",
        "command",
        "platform",
        "repository",
        "timestamp"
      ],
      "properties": {
        "output_schema_version": {
          "type": "string"
        },
        "scanner": {
          "$ref": "#/$defs/auditScannerMetadata"
        },
        "ruleset": {
          "$ref": "#/$defs/auditRulesetMetadata"
        },
        "host_profiles": {
          "$ref": "#/$defs/auditHostProfileMetadata"
        },
        "config": {
          "$ref": "#/$defs/auditConfigMetadata"
        },
        "scan": {
          "$ref": "#/$defs/auditScanMetadata"
        },
        "command": {
          "$ref": "#/$defs/auditCommandMetadata"
        },
        "platform": {
          "anyOf": [
            {
              "$ref": "#/$defs/auditPlatformMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/auditRepositoryMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "timestamp": {
          "$ref": "#/$defs/optionalString"
        }
      },
      "additionalProperties": false
    },
    "auditScannerMetadata": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "auditRulesetMetadata": {
      "type": "object",
      "required": [
        "version",
        "hash"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "auditHostProfileMetadata": {
      "type": "object",
      "required": [
        "selected",
        "version",
        "hash"
      ],
      "properties": {
        "selected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "auditConfigMetadata": {
      "type": "object",
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/optionalString"
        },
        "hash": {
          "$ref": "#/$defs/optionalString"
        }
      },
      "additionalProperties": false
    },
    "auditScanMetadata": {
      "type": "object",
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/optionalString"
        }
      },
      "additionalProperties": false
    },
    "auditCommandMetadata": {
      "type": "object",
      "required": [
        "name",
        "format",
        "mode",
        "profiles",
        "fail_on",
        "supply_chain",
        "strict_supply_chain"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/optionalString"
        },
        "format": {
          "$ref": "#/$defs/optionalString"
        },
        "mode": {
          "$ref": "#/$defs/optionalString"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fail_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supply_chain": {
          "type": "boolean"
        },
        "strict_supply_chain": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "auditPlatformMetadata": {
      "type": "object",
      "required": [
        "os",
        "arch",
        "family"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "family": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "auditRepositoryMetadata": {
      "type": "object",
      "required": [
        "remote_url",
        "commit",
        "dirty"
      ],
      "properties": {
        "remote_url": {
          "$ref": "#/$defs/optionalString"
        },
        "commit": {
          "$ref": "#/$defs/optionalString"
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "supplyChainInventory": {
      "type": "object",
      "required": [
        "licenses",
        "trust_manifests",
        "external_urls",
        "remote_dependencies",
        "dependency_manifests",
        "package_managers",
        "lockfiles",
        "executables",
        "binaries",
        "checksums",
        "permissions",
        "offline_readiness"
      ],
      "properties": {
        "licenses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/licenseEvidence"
          }
        },
        "trust_manifests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trustManifest"
          }
        },
        "external_urls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalUrl"
          }
        },
        "remote_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/remoteDependency"
          }
        },
        "dependency_manifests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyManifestEvidence"
          }
        },
        "package_managers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packageManagerEvidence"
          }
        },
        "lockfiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockfileEvidence"
          }
        },
        "executables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executableArtifact"
          }
        },
        "binaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binaryArtifact"
          }
        },
        "checksums": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checksumEvidence"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permissionEvidence"
          }
        },
        "offline_readiness": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/offlineReadiness"
          }
        }
      },
      "additionalProperties": false
    },
    "scanSummary": {
      "type": "object",
      "required": [
        "package_count",
        "finding_count",
        "suppressed_finding_count",
        "invalid_manifest_count",
        "broken_reference_count",
        "actual_secret_evidence_count",
        "prompt_secret_exposure_count"
      ],
      "properties": {
        "package_count": {
          "type": "integer",
          "minimum": 0
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed_finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_manifest_count": {
          "type": "integer",
          "minimum": 0
        },
        "broken_reference_count": {
          "type": "integer",
          "minimum": 0
        },
        "actual_secret_evidence_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of actual secret evidence signals such as secret-like environment reads, secret-bearing data exfiltration findings, and declared or observed secret permissions."
        },
        "prompt_secret_exposure_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of prompt-risk findings that mention exposing secrets. These are not counted as actual secret usage evidence."
        }
      },
      "additionalProperties": false
    },
    "licenseEvidence": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "scope",
        "normalized",
        "raw",
        "confidence"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "scope": {
          "$ref": "#/$defs/licenseScope"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        }
      },
      "additionalProperties": false
    },
    "trustManifest": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "format",
        "normalized",
        "raw",
        "confidence",
        "valid",
        "diagnostics",
        "skill",
        "provenance",
        "permissions",
        "declared_dependencies"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "format": {
          "$ref": "#/$defs/trustManifestFormat"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        },
        "valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trustManifestDiagnostic"
          }
        },
        "skill": {
          "anyOf": [
            {
              "$ref": "#/$defs/trustManifestSkill"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/trustManifestProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/trustManifestPermissions"
            },
            {
              "type": "null"
            }
          ]
        },
        "declared_dependencies": {
          "$ref": "#/$defs/trustManifestDeclaredDependencies"
        }
      },
      "additionalProperties": false
    },
    "trustManifestDiagnostic": {
      "type": "object",
      "required": [
        "path",
        "line",
        "kind",
        "message",
        "field"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "kind": {
          "$ref": "#/$defs/trustManifestDiagnosticKind"
        },
        "message": {
          "type": "string"
        },
        "field": {
          "$ref": "#/$defs/optionalString"
        }
      },
      "additionalProperties": false
    },
    "trustManifestSkill": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/optionalString"
        },
        "version": {
          "$ref": "#/$defs/optionalString"
        }
      },
      "additionalProperties": false
    },
    "trustManifestProvenance": {
      "type": "object",
      "required": [
        "source",
        "commit",
        "signed"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/optionalString"
        },
        "commit": {
          "$ref": "#/$defs/optionalString"
        },
        "signed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "trustManifestPermissions": {
      "type": "object",
      "required": [
        "network",
        "filesystem_write",
        "secrets"
      ],
      "properties": {
        "network": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "filesystem_write": {
          "$ref": "#/$defs/optionalString"
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "trustManifestDeclaredDependencies": {
      "type": "object",
      "required": [
        "commands",
        "packages"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trustManifestPackageDependency"
          }
        }
      },
      "additionalProperties": false
    },
    "trustManifestPackageDependency": {
      "type": "object",
      "required": [
        "ecosystem",
        "name",
        "version"
      ],
      "properties": {
        "ecosystem": {
          "$ref": "#/$defs/optionalString"
        },
        "name": {
          "$ref": "#/$defs/optionalString"
        },
        "version": {
          "$ref": "#/$defs/optionalString"
        }
      },
      "additionalProperties": false
    },
    "externalUrl": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "kind",
        "normalized",
        "raw",
        "confidence",
        "pinned"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "kind": {
          "$ref": "#/$defs/externalUrlKind"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        },
        "pinned": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "remoteDependency": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "kind",
        "package_manager",
        "name",
        "version",
        "normalized",
        "raw",
        "confidence",
        "pinned"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "kind": {
          "$ref": "#/$defs/remoteDependencyKind"
        },
        "package_manager": {
          "anyOf": [
            {
              "$ref": "#/$defs/packageManagerKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "$ref": "#/$defs/optionalString"
        },
        "version": {
          "$ref": "#/$defs/optionalString"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        },
        "pinned": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "dependencyManifestEvidence": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "manager",
        "normalized",
        "raw",
        "confidence",
        "dependency_count",
        "unpinned_dependency_count",
        "pinning"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "manager": {
          "$ref": "#/$defs/packageManagerKind"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        },
        "dependency_count": {
          "type": "integer",
          "minimum": 0
        },
        "unpinned_dependency_count": {
          "type": "integer",
          "minimum": 0
        },
        "pinning": {
          "$ref": "#/$defs/dependencyManifestPinningKind"
        }
      },
      "additionalProperties": false
    },
    "packageManagerEvidence": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "manager",
        "manifest_path",
        "normalized",
        "raw",
        "confidence"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "manager": {
          "$ref": "#/$defs/packageManagerKind"
        },
        "manifest_path": {
          "$ref": "#/$defs/optionalString"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        }
      },
      "additionalProperties": false
    },
    "lockfileEvidence": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "manager",
        "normalized",
        "raw",
        "confidence"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "manager": {
          "$ref": "#/$defs/packageManagerKind"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        }
      },
      "additionalProperties": false
    },
    "executableArtifact": {
      "type": "object",
      "required": [
        "path",
        "line",
        "source",
        "kind",
        "language",
        "reason",
        "referenced",
        "normalized",
        "raw",
        "confidence"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/optionalLine"
        },
        "source": {
          "$ref": "#/$defs/supplyChainSourceKind"
        },
        "kind": {
          "$ref": "#/$defs/executableKind"
        },
        "language": {
          "$ref": "#/$defs/optionalString"
        },
        "reason": {
          "type": "string"
        },
        "referenced": {
          "type": "boolean"
        },
        "normalized": {
          "type": "string"
        },
        "raw": {
          "$ref": "#/$defs/optionalString"
        },
        "confidence": {
          "$ref": "#/$defs/evidenceConfidence"
        }
      },
      "additionalProperties": false
    },
    "binaryArtifact": {
